# PostgreSQL connection string.
# Local (docker compose provided in this repo, host port 5433):
DATABASE_URL=postgres://ajaia:ajaia@localhost:5433/ajaia_docs
# On Supabase (free tier), use the connection string from Project Settings -> Database,
# e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Secret used to sign session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-secret-change-me

# Optional: skips DB checks for i18n/tests; must be reachable for the app to work
NEXT_TELEMETRY_DISABLED=1
